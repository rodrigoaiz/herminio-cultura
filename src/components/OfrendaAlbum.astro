---
// Álbum de Día de Muertos: foto con calaverita, sólo foto o sólo calaverita, revueltas en mosaico de dos columnas (se leen de arriba abajo, columna por columna).
// Las fotos se amplían en FotoVisor al tocarlas (clase .ampliable).
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
// note: el texto que la familia mandó junto a la foto.
export type OfrendaEntry = { name: string; photo?: ImageMetadata; alt?: string; title?: string; calaverita?: string; note?: string };
const { entries } = Astro.props as { entries: OfrendaEntry[] };
const items = await Promise.all(entries.map(async entry => ({
 ...entry,
 full: entry.photo && (await getImage({ src: entry.photo, width: Math.min(1600, entry.photo.width) })).src,
})));
---
<ul class="my-12 list-none columns-2 gap-x-10 p-0 narrow:columns-1">
 {items.map((entry, i) => <li class="ofrenda m-0 mb-14 break-inside-avoid pt-1">
  <figure class="m-0">
   <figcaption class="mb-3 px-2">
    {/* Palabras alternadas en coral y tinta, como los nombres del álbum impreso. */}
    <span class="font-display text-[26px] leading-tight font-bold">{entry.name.split(' ').map((word, w) => <span class={w % 2 ? '' : 'text-coral'}>{word} </span>)}</span>
    {entry.note && <span class="mt-1 block text-sm leading-relaxed">{entry.note}</span>}
   </figcaption>
   {entry.photo && <button class={`ampliable ofrenda-marco w-full transition-transform hover:rotate-0 ${i % 2 ? 'rotate-1' : '-rotate-1'}`} type="button" data-full={entry.full} data-alt={entry.alt} aria-label={`Ampliar la foto de la ofrenda: ${entry.name}`}>
    <Image class="block aspect-[4/3] h-auto w-full object-cover" src={entry.photo} alt={entry.alt ?? ''} widths={[480, 960]} sizes="(max-width: 700px) 90vw, 480px" />
   </button>}
   {entry.calaverita && <blockquote class={`relative bg-note shadow-[2px_6px_12px_#0002] ${entry.photo ? 'mx-4 -mt-6 px-5 py-4' : 'm-0 px-7 py-8'} ${i % 2 ? '-rotate-1' : 'rotate-1'}`}>
    {entry.title && <p class="m-0 mb-2 text-xs font-bold tracking-[.06em] uppercase">{entry.title}</p>}
    <p class="m-0 font-display text-xl leading-snug font-semibold">{entry.calaverita.split('\n').map(line => <span class="block pl-4 -indent-4">{line}</span>)}</p>
   </blockquote>}
  </figure>
 </li>)}
</ul>
