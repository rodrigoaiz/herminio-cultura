---
// Álbum de Día de Muertos: foto con calaverita, sólo foto o sólo calaverita, revueltas en mosaico de dos columnas (se leen de arriba abajo, columna por columna).
// Las fotos se amplían en un <dialog> al tocarlas.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
export type OfrendaEntry = { name: string; photo?: ImageMetadata; alt?: string; calaverita?: string };
const { entries } = Astro.props as { entries: OfrendaEntry[] };
const items = await Promise.all(entries.map(async entry => ({
 ...entry,
 full: entry.photo && (await getImage({ src: entry.photo, width: Math.min(1600, entry.photo.width) })).src,
})));
---
<ul class="my-12 list-none columns-2 gap-x-10 p-0 narrow:columns-1">
 {items.map((entry, i) => <li class="ofrenda m-0 mb-14 break-inside-avoid pt-1">
  <figure class="m-0">
   {entry.photo && <button class={`block w-full cursor-zoom-in border-0 bg-white p-2 shadow-[3px_8px_18px_#0003] transition-transform hover:rotate-0 ${i % 2 ? 'rotate-1' : '-rotate-1'}`} type="button" data-full={entry.full} data-alt={entry.alt} aria-label={`Ampliar la foto de la ofrenda: ${entry.name}`}>
    <Image class="block aspect-[4/3] h-auto w-full object-cover" src={entry.photo} alt={entry.alt ?? ''} widths={[480, 960]} sizes="(max-width: 700px) 90vw, 480px" />
   </button>}
   {entry.calaverita && <blockquote class={`relative bg-note shadow-[2px_6px_12px_#0002] ${entry.photo ? 'mx-4 -mt-6 px-5 py-4' : 'm-0 px-7 py-8'} ${i % 2 ? '-rotate-1' : 'rotate-1'}`}>
    <p class="m-0 font-display text-xl leading-snug font-semibold">{entry.calaverita.split('\n').map(line => <span class="block pl-4 -indent-4">{line}</span>)}</p>
   </blockquote>}
   <figcaption class="mt-4 px-4 text-xs font-bold tracking-[.06em] text-coral uppercase">{entry.name}</figcaption>
  </figure>
 </li>)}
</ul>
<dialog class="ofrenda-visor m-auto max-h-[92vh] max-w-[92vw] overflow-visible border-0 bg-transparent p-0">
 <img class="block max-h-[88vh] max-w-[92vw] bg-white object-contain p-2" alt="" />
 <button class="absolute -top-4 -right-4 grid size-10 cursor-pointer place-items-center rounded-full border-0 bg-paper text-ink shadow-md" type="button" aria-label="Cerrar foto"><svg class="size-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg></button>
</dialog>
<script>
 const visor = document.querySelector<HTMLDialogElement>('.ofrenda-visor')!;
 const img = visor.querySelector('img')!;
 document.querySelectorAll<HTMLButtonElement>('[data-full]').forEach(button => button.addEventListener('click', () => {
  img.src = button.dataset.full!;
  img.alt = button.dataset.alt ?? '';
  visor.showModal();
 }));
 // Se cierra con la X, con Esc (nativo del <dialog>) o tocando fuera de la foto.
 visor.addEventListener('click', event => { if (event.target === visor || (event.target as Element).closest('button')) visor.close(); });
</script>
