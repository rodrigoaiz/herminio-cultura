---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  image?: ImageMetadata;
  imageAlt?: string;
  publishedTime?: Date;
  noindex?: boolean;
}

const { title, description, type = 'website', image, imageAlt, publishedTime, noindex = false } = Astro.props;
const siteName = 'Herminio Cultura';
const canonical = new URL(Astro.url.pathname, Astro.site);

// WhatsApp y Facebook piden JPG/PNG de 1200×630; la portada de cada artículo se recorta a ese formato.
// En imágenes verticales (carteles) se conserva la parte de arriba, donde suelen estar el título y el logo.
const ogImage = image
  ? await getImage({ src: image, width: 1200, height: 630, fit: 'cover', position: image.height > image.width ? 'top' : 'center', format: 'jpg', quality: 80 })
  : undefined;
const imageUrl = new URL(ogImage?.src ?? '/og-default.jpg', Astro.site).href;
// Astro no agranda imágenes: si la original es más angosta que 1200 px, la salida conserva su ancho.
const imageWidth = image ? Math.min(1200, image.width) : 1200;
const imageHeight = 630;
const alt = ogImage ? (imageAlt || title) : 'La cultura la hacemos juntos. Comisión de Cultura, Escuela Herminio Almendros.';
---
<title>{title}</title>
<meta name="description" content={description}/>
<link rel="canonical" href={canonical.href}/>
{noindex && <meta name="robots" content="noindex"/>}

<meta property="og:site_name" content={siteName}/>
<meta property="og:locale" content="es_MX"/>
<meta property="og:type" content={type}/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content={canonical.href}/>
<meta property="og:image" content={imageUrl}/>
<meta property="og:image:type" content="image/jpeg"/>
<meta property="og:image:width" content={imageWidth}/>
<meta property="og:image:height" content={imageHeight}/>
<meta property="og:image:alt" content={alt}/>
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()}/>}

<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={title}/>
<meta name="twitter:description" content={description}/>
<meta name="twitter:image" content={imageUrl}/>
<meta name="twitter:image:alt" content={alt}/>
