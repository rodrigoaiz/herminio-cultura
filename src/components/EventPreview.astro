---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
interface Props { past?: boolean }
const { past = false } = Astro.props;
// Un evento pasa al historial al día siguiente de su fecha (hora de la CDMX, al construir el sitio).
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format(new Date());
const isPast = (date: Date) => date.toISOString().slice(0, 10) < today;
// Próximos eventos del más cercano al más lejano; el historial, del más reciente al más antiguo.
const eventos = (await getCollection('eventos', ({ data }) => isPast(data.date) === past))
 .sort((a, b) => (a.data.date.getTime() - b.data.date.getTime()) * (past ? -1 : 1) || a.id.localeCompare(b.id));
---
{eventos.length > 0 && <div class="grid grid-cols-3 gap-12 compact:grid-cols-2 narrow:grid-cols-1 narrow:gap-10">
 {eventos.map(({ id, data }) => <article class="relative flex min-w-0 flex-col">
  <Image class="aspect-[4/3] h-auto w-full bg-white object-cover shadow-[3px_8px_18px_#0002]" src={data.cover} alt={data.coverAlt} style={{ objectPosition: data.coverPosition }} width={720} format="webp" />
  <div class="pt-6"><h3 class="mt-0 mb-4 text-3xl leading-[1.1] narrow:text-2xl"><a class="text-ink no-underline after:absolute after:inset-0" href={`/cartelera/${id}/`}>{data.title}</a></h3><div class="metadata"><span>{data.type}</span><span>{data.when}</span><span>{data.where}</span></div><p class="mt-4 mb-0 max-w-100 text-sm">{data.summary}</p></div>
 </article>)}
</div>}
