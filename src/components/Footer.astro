---
const links = [['/boletines/','Boletines'],['/cartelera/','Cartelera'],['/lecturas/','Lecturas']];
// Datos de contacto tomados de herminioalmendros.com (octubre de 2026).
const address = 'Chimalcoyotl 97-A, Col. Toriello Guerra, Tlalpan, 14050, Ciudad de México';
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`Escuela Herminio Almendros, ${address}`)}`;
const heading = 'mt-0 mb-4 font-sans text-[11px] font-semibold tracking-[.08em] text-gold uppercase';
const link = 'border-b border-transparent no-underline hover:border-gold hover:text-gold';
const external = { target: '_blank', rel: 'noopener' };
---
<footer class="bg-ink px-[max(48px,calc((100vw_-_1152px)_/_2))] pt-16 pb-10 text-xs text-paper narrow:px-6 narrow:pt-12">
 <div class="grid grid-cols-[1.2fr_1fr_1fr_1fr] gap-12 compact:grid-cols-2 narrow:grid-cols-1 narrow:gap-10">
  <div><a class="block w-fit" href="/" aria-label="Herminio Cultura, inicio"><img class="block h-auto w-44 narrow:w-38" src="/logos/EscuelaHerminioAlmendrosLogo-Blanco.png" alt="Escuela Herminio Almendros" width="1584" height="830" loading="lazy"></a><p class="mt-6 mb-1 font-semibold">Comisión de Cultura</p><p class="m-0 max-w-60 text-mist">Un espacio de las familias para descubrir y compartir.</p></div>
  <div><h2 class={heading}>La escuela</h2><address class="mb-4 leading-[1.7] not-italic">Chimalcoyotl 97-A<br>Col. Toriello Guerra, Tlalpan<br>14050, Ciudad de México</address><a class={link} href={mapUrl} {...external}>Ver en el mapa</a></div>
  <div><h2 class={heading}>Contacto</h2><ul class="m-0 list-none space-y-2 p-0"><li><a class={link} href="tel:+525556068899">55 5606 8899</a> · <a class={link} href="tel:+525556652155">55 5665 2155</a></li><li><a class={link} href="https://wa.me/525527095530" {...external}>WhatsApp 55 2709 5530</a></li><li><a class={`${link} break-all`} href="mailto:herminioalmendros@hotmail.com">herminioalmendros@hotmail.com</a></li><li><a class={link} href="https://www.herminioalmendros.com/" {...external}>herminioalmendros.com</a></li></ul></div>
  <div><h2 class={heading}>Comisión de Cultura</h2><nav aria-label="Al pie de página"><ul class="m-0 mb-4 list-none space-y-2 p-0">{links.map(([href,label]) => <li><a class={link} href={href}>{label}</a></li>)}</ul></nav><a class={link} href="mailto:comiteculturaherminioalmendros@gmail.com" title="comiteculturaherminioalmendros@gmail.com">Escribir a la comisión</a></div>
 </div>
 <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-paper/15 pt-6 text-mist"><p class="m-0">Escuela Herminio Almendros · Comisión de Cultura</p><ul class="m-0 flex list-none gap-6 p-0"><li><a class={link} href="https://www.facebook.com/Comunidad-Herminio-Almendros-756396684476777/" {...external}>Facebook</a></li><li><a class={link} href="https://instagram.com/escuelaherminioalmendros/" {...external}>Instagram</a></li></ul></div>
</footer>
