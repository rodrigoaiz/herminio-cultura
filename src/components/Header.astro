---
const { home = false, section = '' } = Astro.props;
const sections = [['boletines','Boletines'],['cartelera','Cartelera'],['lecturas','Lecturas']];
const navLink = 'border-b border-transparent py-2 text-sm font-semibold no-underline hover:border-coral hover:text-coral aria-[current]:border-coral aria-[current]:text-coral narrow:text-xs tiny:text-[11px]';
---
<header class="fixed inset-x-8 top-5 z-80 mx-auto flex h-16 max-w-[1392px] items-center justify-between gap-8 glass-header rounded-2xl px-8 py-2 narrow:inset-x-2 narrow:top-2 narrow:h-12 narrow:gap-3 narrow:rounded-lg narrow:px-3 tiny:gap-2 tiny:px-2">
 <a class="flex items-center gap-3 text-xl leading-none font-bold tracking-tight no-underline narrow:gap-2 narrow:text-lg tiny:gap-1 tiny:text-base" href="/" aria-label="Herminio Cultura, inicio"><img class="size-10 narrow:size-7 tiny:size-6" src="/assets/flor.svg" alt="" width="32" height="32"/><span><span class="max-[480px]:hidden">Herminio Almendros</span><span class="mt-1 block text-[11px] font-semibold tracking-[.06em] uppercase max-[480px]:mt-0 max-[480px]:text-[13px] max-[480px]:leading-[1.15] max-[480px]:font-bold max-[480px]:tracking-normal max-[480px]:normal-case">Comité de Cultura</span></span></a>
 <nav class="flex items-center gap-10 narrow:gap-4 tiny:gap-3" aria-label="Secciones">{sections.map(([id,label]) => <a class={navLink} href={`/${id}/`} aria-current={section === id ? 'page' : undefined}>{label}</a>)}</nav>
 {home && <a class="flex items-center gap-3 text-xs font-semibold no-underline hover:text-coral compact:hidden" href="#descubrir">Explorar la cultura <svg class="size-5" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>}
</header>
