---
interface Props {
  title: string;
}

const { title } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`;
---
<div class="share-links">
 <a class="text-link" href={whatsapp} target="_blank" rel="noopener">Enviar por WhatsApp</a>
 {/* El menú nativo de compartir solo aparece donde el navegador lo ofrece. */}
 <button class="text-link" type="button" data-share-title={title} data-share-url={url} hidden>Compartir</button>
</div>

<script>
 for (const button of document.querySelectorAll<HTMLButtonElement>('[data-share-url]')) {
  if (!navigator.share) continue;
  button.hidden = false;
  button.addEventListener('click', () => {
   // Cancelar el menú también rechaza la promesa; no hay nada que avisar.
   navigator.share({ title: button.dataset.shareTitle, url: button.dataset.shareUrl }).catch(() => {});
  });
 }
</script>
