---
// Una tira de papel picado sobre la hoja y ramos de cempasúchil en las esquinas. Va dentro de un <main class="reader relative">.
import { picadoFlag } from '../scripts/paper-art.js';
const picado = Array.from({ length: 13 }, (_, i) => {
 const x = 42 + i * 84, t = x / 1092;
 return picadoFlag(i, `translate(${x} ${(6 + 64 * t * (1 - t)).toFixed(1)}) rotate(${((0.5 - t) * 8).toFixed(1)})`);
}).join('');
const marigold = (x: number, y: number, r: number) => Array.from({ length: 10 }, (_, k) => `<circle cx="${(x + r * 0.62 * Math.cos(k * Math.PI / 5)).toFixed(1)}" cy="${(y + r * 0.62 * Math.sin(k * Math.PI / 5)).toFixed(1)}" r="${(r * 0.42).toFixed(1)}" fill="#e8892b"/>`).join('') + `<circle cx="${x}" cy="${y}" r="${(r * 0.5).toFixed(1)}" fill="#f2a33a"/><circle cx="${x}" cy="${y}" r="${(r * 0.22).toFixed(1)}" fill="#d9701f"/>`;
const bouquet = `<path d="M60 150Q50 100 30 70M60 150Q70 95 100 60M60 150Q62 110 64 40" stroke="#5d7a55" stroke-width="4" fill="none"/>${marigold(30, 64, 26)}${marigold(100, 56, 24)}${marigold(64, 36, 28)}`;
---
<svg class="pointer-events-none absolute -top-5 left-1/2 w-[112%] -translate-x-1/2 narrow:w-full drop-shadow-[2px_6px_6px_#0004]" viewBox="0 0 1092 110" aria-hidden="true"><path d="M0 6Q546 70 1092 6" stroke="#3a2c4f" stroke-width="2" fill="none"/><Fragment set:html={picado} /></svg>
<svg class="pointer-events-none absolute -bottom-20 -left-24 w-36 -rotate-12 narrow:hidden" viewBox="0 0 130 160" aria-hidden="true"><Fragment set:html={bouquet} /></svg>
<svg class="pointer-events-none absolute top-1/3 -right-14 w-32 rotate-12 narrow:hidden" viewBox="0 0 130 160" aria-hidden="true"><Fragment set:html={bouquet} /></svg>
