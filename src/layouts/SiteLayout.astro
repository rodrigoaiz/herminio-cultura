---
import '../styles/global.css';
import Header from '../components/Header.astro';
const { title, description, home = false, section = '', bodyClass = '', contentId = 'contenido' } = Astro.props;
---
<!doctype html>
<html lang="es">
 <head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#fbf5e8"/>
  <title>{title}</title><meta name="description" content={description}/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={home ? 'website' : 'article'}/><meta property="og:locale" content="es_MX"/>
  <link rel="icon" href="/assets/flor.svg" type="image/svg+xml"/>
  <link rel="preload" href="/assets/cormorant-garamond.ttf" as="font" type="font/ttf" crossorigin/>
 </head>
 <body class={bodyClass}>
  <a class="skip" href={home ? '#descubrir' : `#${contentId}`}>Saltar al contenido</a>
  <Header home={home} section={section}/>
  <slot/>
 </body>
</html>
