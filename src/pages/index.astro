---
import SiteLayout from '../layouts/SiteLayout.astro';
import PaperFilters from '../components/PaperFilters.astro';
import Footer from '../components/Footer.astro';
import BookShelf from '../components/BookShelf.astro';
import EventPreview from '../components/EventPreview.astro';
import BulletinFeed from '../components/BulletinFeed.tsx';
import { getBulletins } from '../lib/bulletins';
const bulletins = await getBulletins();
---
<SiteLayout home title="Herminio · La cultura entra en escena" description="Cartelera, libros y voces de la comunidad. Un espacio de la Comisión de Cultura de la Escuela Herminio Almendros.">
<PaperFilters />
<main id="contenido">
<div class="theatre-intro" id="bienvenida" aria-label="Bienvenida al teatro de papel">
 <div class="stage-window">
  <div class="sets-stack">
   <section class="intro-scene scene-garden" data-name="El encuentro" aria-label="El encuentro">
    <div class="scene-world" aria-hidden="true"><div class="sky"><span class="sun"><img src="/assets/flor.svg" alt=""></span><span class="cloud cloud-c"><svg viewBox="0 0 160 84"><path d="M58 64C52 40 74 24 94 32c8-22 46-20 46 6 16 0 22 18 10 26Z" fill="#e4d7bb"/><path d="M16 80C2 80 1 59 19 56c-3-17 17-27 30-18 4-22 36-28 46-6 12-11 35-4 33 14 17-4 29 14 20 26 4 6-1 8-6 8Z" fill="#fbf5e8"/><path d="M12 72q68 6 136 0" stroke="#d9cbab" stroke-width="2" fill="none" stroke-linecap="round"/></svg></span><span class="cloud cloud-a"><svg viewBox="0 0 160 84"><path d="M58 64C52 40 74 24 94 32c8-22 46-20 46 6 16 0 22 18 10 26Z" fill="#e4d7bb"/><path d="M16 80C2 80 1 59 19 56c-3-17 17-27 30-18 4-22 36-28 46-6 12-11 35-4 33 14 17-4 29 14 20 26 4 6-1 8-6 8Z" fill="#fbf5e8"/><path d="M12 72q68 6 136 0" stroke="#d9cbab" stroke-width="2" fill="none" stroke-linecap="round"/></svg></span><span class="cloud cloud-b"><svg viewBox="0 0 160 84"><path d="M58 64C52 40 74 24 94 32c8-22 46-20 46 6 16 0 22 18 10 26Z" fill="#e4d7bb"/><path d="M16 80C2 80 1 59 19 56c-3-17 17-27 30-18 4-22 36-28 46-6 12-11 35-4 33 14 17-4 29 14 20 26 4 6-1 8-6 8Z" fill="#fbf5e8"/><path d="M12 72q68 6 136 0" stroke="#d9cbab" stroke-width="2" fill="none" stroke-linecap="round"/></svg></span></div><div class="back-ridge"></div><div class="hill hill-back"><svg class="tuft" style="--x:20%;--y:10%;--s:1;--d:4.6s" viewBox="0 0 40 30"><path d="M20 30Q14 12 9 3q9 9 13 27Zm0 0q1-19 9-29-2 14-4 29Zm-2 0Q10 18 0 15q13 1 20 15Zm4 0q7-12 18-17-10 8-13 17Zm-9 0Q9 22 3 23q8-2 12 7Zm10 0q6-9 12-9-7 3-9 9Z" fill="#7e9b72"/></svg><svg class="tuft flower" style="--x:27%;--y:6.3%;--s:0.8;--d:5.2s" viewBox="0 0 30 40"><path d="M15 40V15" stroke="#5d7a55" stroke-width="2"/><path d="M15 30q-8-2-10-8 8 0 10 8" fill="#5d7a55"/><g fill="#e9c9b6"><circle cx="15" cy="7" r="5"/><circle cx="9" cy="12" r="5"/><circle cx="21" cy="12" r="5"/><circle cx="11" cy="18" r="4.5"/><circle cx="19" cy="18" r="4.5"/></g><circle cx="15" cy="13" r="3.5" fill="#eab64f"/></svg><svg class="tuft" style="--x:35%;--y:2.3%;--s:0.9;--d:5.4s" viewBox="0 0 40 30"><path d="M20 30Q14 12 9 3q9 9 13 27Zm0 0q1-19 9-29-2 14-4 29Zm-2 0Q10 18 0 15q13 1 20 15Zm4 0q7-12 18-17-10 8-13 17Zm-9 0Q9 22 3 23q8-2 12 7Zm10 0q6-9 12-9-7 3-9 9Z" fill="#7e9b72"/></svg><svg class="tuft" style="--x:52%;--y:0.2%;--s:1.1;--d:4.9s" viewBox="0 0 40 30"><path d="M20 30Q14 12 9 3q9 9 13 27Zm0 0q1-19 9-29-2 14-4 29Zm-2 0Q10 18 0 15q13 1 20 15Zm4 0q7-12 18-17-10 8-13 17Zm-9 0Q9 22 3 23q8-2 12 7Zm10 0q6-9 12-9-7 3-9 9Z" fill="#728f68"/></svg><svg class="tuft flower" style="--x:58%;--y:0.6%;--s:0.9;--d:5.8s" viewBox="0 0 30 40"><path d="M15 40V15" stroke="#5d7a55" stroke-width="2"/><path d="M15 30q-8-2-10-8 8 0 10 8" fill="#5d7a55"/><g fill="#cf503c"><circle cx="15" cy="7" r="5"/><circle cx="9" cy="12" r="5"/><circle cx="21" cy="12" r="5"/><circle cx="11" cy="18" r="4.5"/><circle cx="19" cy="18" r="4.5"/></g><circle cx="15" cy="13" r="3.5" fill="#eab64f"/></svg><svg class="tuft" style="--x:63%;--y:1.7%;--s:0.8;--d:4.4s" viewBox="0 0 40 30"><path d="M20 30Q14 12 9 3q9 9 13 27Zm0 0q1-19 9-29-2 14-4 29Zm-2 0Q10 18 0 15q13 1 20 15Zm4 0q7-12 18-17-10 8-13 17Zm-9 0Q9 22 3 23q8-2 12 7Zm10 0q6-9 12-9-7 3-9 9Z" fill="#7e9b72"/></svg></div><div class="scene-visual" data-art="0"></div><div class="hill hill-front"><svg class="tuft" style="--x:30%;--y:4.2%;--s:1.3;--d:4.2s" viewBox="0 0 40 30"><path d="M20 30Q14 12 9 3q9 9 13 27Zm0 0q1-19 9-29-2 14-4 29Zm-2 0Q10 18 0 15q13 1 20 15Zm4 0q7-12 18-17-10 8-13 17Zm-9 0Q9 22 3 23q8-2 12 7Zm10 0q6-9 12-9-7 3-9 9Z" fill="#c48a3a"/></svg><svg class="tuft flower" style="--x:38%;--y:1.5%;--s:1.1;--d:5.1s" viewBox="0 0 30 40"><path d="M15 40V15" stroke="#5d7a55" stroke-width="2"/><path d="M15 30q-8-2-10-8 8 0 10 8" fill="#5d7a55"/><g fill="#fbf5e8"><circle cx="15" cy="7" r="5"/><circle cx="9" cy="12" r="5"/><circle cx="21" cy="12" r="5"/><circle cx="11" cy="18" r="4.5"/><circle cx="19" cy="18" r="4.5"/></g><circle cx="15" cy="13" r="3.5" fill="#eab64f"/></svg><svg class="tuft" style="--x:45%;--y:0.25%;--s:1.1;--d:4.8s" viewBox="0 0 40 30"><path d="M20 30Q14 12 9 3q9 9 13 27Zm0 0q1-19 9-29-2 14-4 29Zm-2 0Q10 18 0 15q13 1 20 15Zm4 0q7-12 18-17-10 8-13 17Zm-9 0Q9 22 3 23q8-2 12 7Zm10 0q6-9 12-9-7 3-9 9Z" fill="#b97b2f"/></svg><svg class="tuft" style="--x:58%;--y:0.64%;--s:1.4;--d:4.5s" viewBox="0 0 40 30"><path d="M20 30Q14 12 9 3q9 9 13 27Zm0 0q1-19 9-29-2 14-4 29Zm-2 0Q10 18 0 15q13 1 20 15Zm4 0q7-12 18-17-10 8-13 17Zm-9 0Q9 22 3 23q8-2 12 7Zm10 0q6-9 12-9-7 3-9 9Z" fill="#c48a3a"/></svg><svg class="tuft flower" style="--x:66%;--y:2.6%;--s:1.2;--d:5.6s" viewBox="0 0 30 40"><path d="M15 40V15" stroke="#5d7a55" stroke-width="2"/><path d="M15 30q-8-2-10-8 8 0 10 8" fill="#5d7a55"/><g fill="#cf503c"><circle cx="15" cy="7" r="5"/><circle cx="9" cy="12" r="5"/><circle cx="21" cy="12" r="5"/><circle cx="11" cy="18" r="4.5"/><circle cx="19" cy="18" r="4.5"/></g><circle cx="15" cy="13" r="3.5" fill="#eab64f"/></svg><svg class="tuft" style="--x:72%;--y:5.1%;--s:1.1;--d:4.3s" viewBox="0 0 40 30"><path d="M20 30Q14 12 9 3q9 9 13 27Zm0 0q1-19 9-29-2 14-4 29Zm-2 0Q10 18 0 15q13 1 20 15Zm4 0q7-12 18-17-10 8-13 17Zm-9 0Q9 22 3 23q8-2 12 7Zm10 0q6-9 12-9-7 3-9 9Z" fill="#b97b2f"/></svg></div><div class="stage-light"></div></div>
    <div class="scene-copy-track" aria-label="Ideas del encuentro">
     <article class="scene-panel"><div class="copy"><h1>La cultura<br>la hacemos<br><em>juntos.</em></h1><p>Un espacio para encontrarnos con los libros, el arte y las ganas de descubrir.</p><a class="paper-link" href="#descubrir">Explorar la cultura <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></div><span class="stage-caption">Pequeñas ideas. Un mundo compartido.</span></article>
     <article class="scene-panel sheet-panel"><div class="intro-sheet paper-surface"><h2>Hay mundos<br>que se abren<br><em>entre todos.</em></h2><p>Un libro que pasa de mano en mano. Una visita que despierta preguntas. Una historia que alguien se anima a contar.</p><p>La Comisión de Cultura es un lugar para compartir esos encuentros.</p><a class="text-link" href="/boletines/">Leer los boletines <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></div></article>
    </div>
   </section>
   <section class="intro-scene scene-town" data-name="Salir a descubrir" aria-label="Salir a descubrir">
    <div class="scene-world" aria-hidden="true"><div class="town-sky"></div><div class="town-buildings"><i><b></b></i><i><b></b></i><i><b></b></i><i><b></b></i><svg class="garland" viewBox="0 0 1500 66"><path d="M0 4Q750 64 1500 4" stroke="#6e5a44" stroke-width="1.4" fill="none"/><path d="M-9 0h18L0 26Z" transform="translate(22 5.7) rotate(4.4)" fill="#cf503c"/><path d="M-9 0h18L0 26Z" transform="translate(66 9.0) rotate(4.2)" fill="#eab64f"/><path d="M-9 0h18L0 26Z" transform="translate(110 12.2) rotate(3.9)" fill="#4b6899"/><path d="M-9 0h18L0 26Z" transform="translate(154 15.1) rotate(3.6)" fill="#9fb397"/><path d="M-9 0h18L0 26Z" transform="translate(198 17.7) rotate(3.4)" fill="#fbf5e8"/><path d="M-9 0h18L0 26Z" transform="translate(242 20.2) rotate(3.1)" fill="#cf503c"/><path d="M-9 0h18L0 26Z" transform="translate(286 22.5) rotate(2.8)" fill="#eab64f"/><path d="M-9 0h18L0 26Z" transform="translate(330 24.6) rotate(2.6)" fill="#4b6899"/><path d="M-9 0h18L0 26Z" transform="translate(374 26.5) rotate(2.3)" fill="#9fb397"/><path d="M-9 0h18L0 26Z" transform="translate(418 28.1) rotate(2.0)" fill="#fbf5e8"/><path d="M-9 0h18L0 26Z" transform="translate(462 29.6) rotate(1.8)" fill="#cf503c"/><path d="M-9 0h18L0 26Z" transform="translate(506 30.8) rotate(1.5)" fill="#eab64f"/><path d="M-9 0h18L0 26Z" transform="translate(550 31.9) rotate(1.2)" fill="#4b6899"/><path d="M-9 0h18L0 26Z" transform="translate(594 32.7) rotate(1.0)" fill="#9fb397"/><path d="M-9 0h18L0 26Z" transform="translate(638 33.3) rotate(0.7)" fill="#fbf5e8"/><path d="M-9 0h18L0 26Z" transform="translate(682 33.8) rotate(0.4)" fill="#cf503c"/><path d="M-9 0h18L0 26Z" transform="translate(726 34.0) rotate(0.1)" fill="#eab64f"/><path d="M-9 0h18L0 26Z" transform="translate(770 34.0) rotate(-0.1)" fill="#4b6899"/><path d="M-9 0h18L0 26Z" transform="translate(814 33.8) rotate(-0.4)" fill="#9fb397"/><path d="M-9 0h18L0 26Z" transform="translate(858 33.4) rotate(-0.7)" fill="#fbf5e8"/><path d="M-9 0h18L0 26Z" transform="translate(902 32.8) rotate(-0.9)" fill="#cf503c"/><path d="M-9 0h18L0 26Z" transform="translate(946 32.0) rotate(-1.2)" fill="#eab64f"/><path d="M-9 0h18L0 26Z" transform="translate(990 30.9) rotate(-1.5)" fill="#4b6899"/><path d="M-9 0h18L0 26Z" transform="translate(1034 29.7) rotate(-1.7)" fill="#9fb397"/><path d="M-9 0h18L0 26Z" transform="translate(1078 28.3) rotate(-2.0)" fill="#fbf5e8"/><path d="M-9 0h18L0 26Z" transform="translate(1122 26.6) rotate(-2.3)" fill="#cf503c"/><path d="M-9 0h18L0 26Z" transform="translate(1166 24.8) rotate(-2.5)" fill="#eab64f"/><path d="M-9 0h18L0 26Z" transform="translate(1210 22.7) rotate(-2.8)" fill="#4b6899"/><path d="M-9 0h18L0 26Z" transform="translate(1254 20.5) rotate(-3.1)" fill="#9fb397"/><path d="M-9 0h18L0 26Z" transform="translate(1298 18.0) rotate(-3.3)" fill="#fbf5e8"/><path d="M-9 0h18L0 26Z" transform="translate(1342 15.3) rotate(-3.6)" fill="#cf503c"/><path d="M-9 0h18L0 26Z" transform="translate(1386 12.4) rotate(-3.9)" fill="#eab64f"/><path d="M-9 0h18L0 26Z" transform="translate(1430 9.3) rotate(-4.1)" fill="#4b6899"/><path d="M-9 0h18L0 26Z" transform="translate(1474 6.0) rotate(-4.4)" fill="#9fb397"/></svg></div><div class="town-floor"></div><div class="scene-visual" data-art="1"></div><div class="stage-light"></div></div>
    <div class="scene-copy-track" aria-label="Ideas para descubrir">
     <article class="scene-panel"><div class="copy"><h2>Afuera hay<br>todo un <em>mundo.</em></h2><p>Una exposición, una función, un paseo. La cultura también empieza al salir a mirar.</p><a class="paper-link" href="/cartelera/">Encontrar un plan <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></div><span class="stage-caption">Arte, paseos y descubrimientos.</span></article>
     <article class="scene-panel sheet-panel"><div class="intro-sheet paper-surface"><h2>Cada mes,<br>nuevos <em>planes.</em></h2><p>Ideas para encontrar la cultura cerca de nosotros.</p><ul class="simple-list"><li>Arte para mirar</li><li>Historias en escena</li><li>Salir a descubrir</li></ul><a class="text-link" href="/cartelera/">Ver la cartelera <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></div></article>
    </div>
   </section>
   <section class="intro-scene scene-night" data-name="Historias compartidas" aria-label="Historias compartidas">
    <div class="scene-world" aria-hidden="true"><div class="night-sky"></div><div class="night-details"><div class="moon-lamp"><svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="53" fill="#f4e9b7"/><circle cx="39" cy="43" r="12" fill="#ccbf89" opacity=".68"/><circle cx="78" cy="71" r="8" fill="#c3b780" opacity=".64"/><circle cx="53" cy="86" r="6" fill="#cbbd88" opacity=".65"/><circle cx="81" cy="37" r="4" fill="#c4b783" opacity=".6"/></svg></div><span class="hanging-star" style="--star-x:26%;--star-y:23%;--star-width:27px"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 1 4.4 9.3L31 12l-7.8 7.5L25 30l-9-5-9 5 1.8-10.5L1 12l10.6-1.7Z" fill="#efd58b" stroke="#a99157" stroke-width=".7"/></svg></span><span class="hanging-star" style="--star-x:42%;--star-y:30%;--star-width:22px"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 1 4.4 9.3L31 12l-7.8 7.5L25 30l-9-5-9 5 1.8-10.5L1 12l10.6-1.7Z" fill="#efd58b" stroke="#a99157" stroke-width=".7"/></svg></span><span class="hanging-star" style="--star-x:58%;--star-y:20%;--star-width:26px"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 1 4.4 9.3L31 12l-7.8 7.5L25 30l-9-5-9 5 1.8-10.5L1 12l10.6-1.7Z" fill="#efd58b" stroke="#a99157" stroke-width=".7"/></svg></span><span class="hanging-star" style="--star-x:78%;--star-y:38%;--star-width:22px"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 1 4.4 9.3L31 12l-7.8 7.5L25 30l-9-5-9 5 1.8-10.5L1 12l10.6-1.7Z" fill="#efd58b" stroke="#a99157" stroke-width=".7"/></svg></span><span class="hanging-star" style="--star-x:88%;--star-y:23%;--star-width:18px"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 1 4.4 9.3L31 12l-7.8 7.5L25 30l-9-5-9 5 1.8-10.5L1 12l10.6-1.7Z" fill="#efd58b" stroke="#a99157" stroke-width=".7"/></svg></span><i class="shooting-star"></i><i class="firefly" style="--fly-x:15%;--fly-y:67%;--fly-size:24px"></i><i class="firefly" style="--fly-x:33%;--fly-y:75%;--fly-size:28px"></i><i class="firefly" style="--fly-x:48%;--fly-y:59%;--fly-size:22px"></i><i class="firefly" style="--fly-x:71%;--fly-y:66%;--fly-size:28px"></i><i class="firefly" style="--fly-x:84%;--fly-y:77%;--fly-size:24px"></i><i class="firefly" style="--fly-x:23%;--fly-y:87%;--fly-size:19px"></i><i class="firefly" style="--fly-x:63%;--fly-y:86%;--fly-size:20px"></i><i class="firefly" style="--fly-x:90%;--fly-y:53%;--fly-size:18px"></i></div><div class="forest-back"></div><div class="forest-front"></div><div class="scene-visual" data-art="2"></div><div class="stage-light"></div></div>
    <div class="scene-copy-track" aria-label="Ideas para compartir">
     <article class="scene-panel"><div class="copy"><h2>Un libro.<br>Muchas <em>miradas.</em></h2><p>Historias que pasan de mano en mano. Reseñas de niñas, niños y personas adultas.</p><a class="paper-link" href="/lecturas/">Asomarse a las lecturas <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></div><span class="stage-caption">Leer también es conversar.</span></article>
     <article class="scene-panel sheet-panel"><div class="intro-sheet paper-surface"><h2>Lo que sigue<br>lo descubrimos<br><em>juntos.</em></h2><p>Un libro que se presta, una salida en familia, una historia que alguien se anima a contar: cada encuentro abre la puerta al siguiente.</p><p>Aquí abajo te esperan los talleres, los planes y las lecturas de la Herminio.</p><a class="scroll-on" href="#descubrir"><span class="scroll-on-arrow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15m-6-6 6 6 6-6"/></svg></span>Sigue bajando</a></div></article>
    </div>
   </section>
  </div>
  <div class="proscenium" aria-hidden="true"><div class="curtain-frame"></div><div class="footlight"></div></div>
  <nav class="stage-controls" aria-label="Recorrido del teatro"><button class="step-arrow" id="step-prev" type="button" aria-label="Paso anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H5m6-6-6 6 6 6"/></svg></button><div class="scene-status" aria-live="polite"><span id="scene-name">El encuentro</span><span id="chapter-progress">1 / 6</span></div><button class="step-arrow" id="step-next" type="button" aria-label="Paso siguiente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></button><div class="theatre-progress" aria-hidden="true"><span></span></div></nav>
 </div>
</div>
<div class="editorial-world home-preview" id="descubrir" tabindex="-1">
 <section class="editorial-section discovery-section" aria-labelledby="discovery-title">
  <div class="section-heading"><h2 id="discovery-title">Lo que hicimos,<br><em>a dónde ir, qué leer.</em></h2><p>Los talleres de la escuela contados por quienes estuvieron, los planes culturales para este fin de semana y los libros que circulan entre las familias de la Herminio.</p></div>
  <div class="preview-heading"><h3 id="bulletins-title">Recién pasó en la Herminio</h3><a class="text-link" href="/boletines/">Todos los boletines <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div>
  <BulletinFeed client:visible items={bulletins} />
 </section>
 <section class="editorial-section home-events" aria-labelledby="plans-title">
  <div class="preview-heading"><h2 id="plans-title">¿Y si salimos<br><em>a descubrir?</em></h2><a class="text-link" href="/cartelera/">Ir a la cartelera <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div>
  <EventPreview />
 </section>
 <section class="editorial-section home-books" aria-labelledby="books-title">
  <div class="preview-heading"><h2 id="books-title">Del estante<br><em>de la comunidad.</em></h2><a class="text-link" href="/lecturas/">Todas las lecturas <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div>
  <BookShelf />
 </section>
 <aside class="mx-auto mb-24 grid max-w-288 grid-cols-[1fr_2fr] items-center gap-20 bg-note p-12 compact:mx-10 compact:gap-12 narrow:mx-6 narrow:mb-16 narrow:grid-cols-1 narrow:gap-8 narrow:px-6 narrow:py-8"><img class="mx-auto h-auto w-full max-w-44 narrow:mx-0 narrow:max-w-24" src="/assets/flor.svg" width="32" height="32" loading="lazy" alt="Comisión de Cultura"><div><h2 class="mt-0 mb-6 text-5xl leading-none narrow:text-4xl">La comisión<br><em>somos las familias.</em></h2><p class="max-w-120 text-base narrow:text-sm">Proponer un taller, recomendar un libro o avisar de un evento: cualquier familia de la Herminio puede sumarse. Escríbenos y lo armamos juntos.</p><a class="text-link" href="mailto:comiteculturaherminioalmendros@gmail.com">Escribir a la comisión <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div></aside>
</div></main>
<Footer />
<script>import '../scripts/world.js';</script>
</SiteLayout>
