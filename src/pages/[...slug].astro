---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { formatGrades } from '../lib/bulletins';
export async function getStaticPaths() {
 const articles = await getCollection('articles');
 return articles.map(article => ({ params: { slug: article.id }, props: { article } }));
}
const { article } = Astro.props;
const { data } = article;
const { Content } = await render(article);
const isoDate = data.date.toISOString().slice(0, 10);
const published = new Intl.DateTimeFormat('es-MX', {dateStyle:'long', timeZone:'UTC'}).format(data.date);
---
<SiteLayout title={`${data.title} · Herminio Cultura`} description={data.description} section={data.section} image={data.cover} imageAlt={data.coverAlt} publishedTime={data.date} bodyClass="reader-body" contentId="lectura">
 <main class="reader" id="lectura">
  <a class="back" href={`/${data.section}/`}>Volver a la sección</a>
  <article>
   <h1>{data.title}</h1>
   <div class="metadata"><span>{data.label}</span>{data.grades.length > 0 && <span>{formatGrades(data.grades)}</span>}<time datetime={isoDate}>{published}</time></div>
   <p class="intro">{data.intro}</p>
   <div class="article-body"><Content /></div>
  </article>
 </main>
 <footer class="reader-footer"><a href={`/${data.section}/`}>Volver a {data.section}</a><p>Comisión de Cultura · Escuela Herminio Almendros</p></footer>
</SiteLayout>
