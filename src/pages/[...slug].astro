---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import ShareLinks from '../components/ShareLinks.astro';
import OfrendaAlbum, { type OfrendaEntry } from '../components/OfrendaAlbum.astro';
import MuertosDecor from '../components/MuertosDecor.astro';
import Footer from '../components/Footer.astro';
import { formatGrades } from '../lib/bulletins';
// Un album.ts junto al index.md convierte el artículo en álbum de Día de Muertos.
const albums = import.meta.glob<{ entries: OfrendaEntry[] }>('../content/articles/**/album.ts', { eager: true });
export async function getStaticPaths() {
 const articles = await getCollection('articles');
 return articles.map(article => ({ params: { slug: article.id }, props: { article } }));
}
const { article } = Astro.props;
const { data } = article;
const { Content } = await render(article);
const album = albums[`../content/articles/${article.id}/album.ts`];
const isoDate = data.date.toISOString().slice(0, 10);
const published = new Intl.DateTimeFormat('es-MX', {dateStyle:'long', timeZone:'UTC'}).format(data.date);
---
<SiteLayout title={`${data.title} · Herminio Cultura`} description={data.description} section={data.section} image={data.cover} imageAlt={data.coverAlt} publishedTime={data.date} bodyClass={album ? 'reader-body muertos-page' : 'reader-body'} contentId="lectura">
 <main class:list={['reader', album && 'relative max-w-[1120px]! pt-20! narrow:pt-14!']} id="lectura">
  {album && <MuertosDecor />}
  <a class="back" href={`/${data.section}/`}>Volver a la sección</a>
  <article class:list={[album && '[&_.article-body>*]:max-w-[736px] [&>p]:max-w-[736px]']}>
   <h1>{data.title}</h1>
   <div class="metadata"><span>{data.label}</span>{formatGrades(data.grades) && <span>{formatGrades(data.grades)}</span>}<time datetime={isoDate}>{published}</time></div>
   <p class="intro">{data.intro}</p>
   <div class="article-body"><Content /></div>
   {album && <OfrendaAlbum entries={album.entries} />}
   <ShareLinks title={data.title} />
  </article>
 </main>
 <Footer />
</SiteLayout>
