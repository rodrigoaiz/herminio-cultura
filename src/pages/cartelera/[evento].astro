---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
export async function getStaticPaths() {
 const eventos = await getCollection('eventos');
 return eventos.map(evento => ({ params: { evento: evento.id }, props: { evento } }));
}
const { evento } = Astro.props;
const { data } = evento;
const { Content } = await render(evento);
---
<SiteLayout title={`${data.title} · Herminio Cultura`} description={data.summary} section="cartelera" image={data.cover} imageAlt={data.coverAlt} bodyClass="reader-body" contentId="lectura">
 <main class="reader" id="lectura">
  <a class="back" href="/cartelera/">Volver a la cartelera</a>
  <article>
   <h1>{data.title}</h1>
   <div class="metadata"><span>{data.type}</span><span>{data.when}</span><span>{data.where}</span>{data.cost && <span>{data.cost}</span>}</div>
   <Image class="mb-8 block h-auto max-h-[75vh] w-full bg-white object-contain p-2 shadow-[3px_8px_18px_#0002]" src={data.cover} alt={data.coverAlt} width={1200} format="webp" loading="eager" />
   <p class="intro">{data.summary}</p>
   <div class="article-body"><Content /></div>
   <a class="text-link" href={`/${data.cartelera}/`}>Ver la cartelera completa <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></a>
  </article>
 </main>
 <footer class="reader-footer"><a href="/cartelera/">Volver a la cartelera</a><p>Comisión de Cultura · Escuela Herminio Almendros</p></footer>
</SiteLayout>
